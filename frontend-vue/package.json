{
  "name": "synchtasks-frontend",
  "version": "1.0.0",
  "description": "Frontend Vue.js pour SyncTasks",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint . --ext .vue,.js,.ts --fix",
    "lint:check": "eslint . --ext .vue,.js,.ts",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
    "lint:report": "eslint . --ext .vue,.js,.ts --format=compact",
    "clean": "rm -rf dist node_modules/.cache",
    "type-check": "vue-tsc --noEmit",
    "check-all": "npm run lint:check && npm run type-check",
    "prepare": "husky install"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^7.0.0",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.4.0",
    "pinia": "^2.1.6",
    "tippy.js": "^6.3.7",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.21.1",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "terser": "^5.24.0",
    "vite": "^4.4.5",
    "vue-tsc": "^1.8.27"
  }
}
